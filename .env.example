# ------------------------------------------------------------------------------
# DocuGen Pro - Environment Variables Configuration Template (.env.example)
# ------------------------------------------------------------------------------
# Rename this file to .env in your local development environment.
# On Vercel, configure these variables in Settings > Environment Variables.

# === Core AI Service Configuration ===
# GEMINI_API_KEY: Secret key used server-side for Gemini developer SDK calls.
# Keep this secret and secure. Never expose this key in client-side code repository.
GEMINI_API_KEY="your_secret_gemini_api_key_here"

# VITE_GEMINI_API_KEY: Publicly exposed key for client-side API executions.
# (Only use this if direct-to-API client integration is absolutely required).
VITE_GEMINI_API_KEY="your_public_gemini_api_key_here"

# === Application Meta Config ===
# APP_URL: The canonical hosting address where your app instance is accessible.
# On production Vercel deployment: Use your production domain (e.g. https://your-app.vercel.app)
APP_URL="https://ais-pre-q43ulohc7kvdx6uhwkngzg-145910217857.europe-west3.run.app"

# === Optional Analytics (Example context) ===
# VITE_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
